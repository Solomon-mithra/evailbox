generator client {
  provider = "prisma-client-js"
}
// SQLite file; src/lib/db.ts and prisma.config.ts default DATABASE_URL to ./data/evailbox.db.
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
enum WorkspaceKind {
  PERSONAL
  WORK
}
enum Priority {
  HIGH
  MEDIUM
  LOW
}
enum Provider {
  GMAIL
  OUTLOOK
}
model User {
  id String @id
  email String @unique
  displayName String @default("")
  replyDrafts ReplyDraft[]
  lastBackgroundSyncAt DateTime?
  workRequested Boolean @default(false)
  workRevision Int @default(0)
  workLeaseId String?
  workLeaseUntil DateTime?
  workNotBefore DateTime @default(now())
  workFailures Int @default(0)
  createdAt DateTime @default(now())
  tags Tag[]
  accounts EmailAccount[]
  emails Email[]
  classifications EmailClassification[]
  notificationPref NotificationPref?
  @@index([workRequested,workNotBefore,lastBackgroundSyncAt])
  @@map("users")
}
model Tag {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String
  name String
  nameKey String
  description String @default("")
  prompt String
  priority Priority @default(MEDIUM)
  keywords Json @default("[]")
  senders Json @default("[]")
  version Int @default(1)
  matchFrom DateTime @default(now())
  historyEmailIds Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  classifications EmailClassification[]
  @@unique([userId,workspace,nameKey])
  @@unique([id,userId])
  @@unique([id,userId,workspace])
  @@map("tags")
}
model EmailAccount {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String
  provider Provider
  email String
  accessToken String
  refreshToken String?
  expiresAt DateTime
  cursor String?
  rescanStartedAt DateTime?
  lastSync DateTime?
  syncError String?
  syncRequested Boolean @default(true)
  syncRevision Int @default(0)
  syncLeaseUntil DateTime?
  syncLeaseId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  emails Email[]
  replyDrafts ReplyDraft[]
  @@unique([userId,workspace,provider,email])
  @@unique([id,userId])
  @@unique([id,userId,workspace])
  @@map("email_accounts")
}
model Email {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String
  accountId String
  lastSeenAt DateTime @default(now())
  contentHash String @default("")
  firstClassifiedAt DateTime?
  inInbox Boolean @default(true)
  replyDraft ReplyDraft?
  providerMessageId String
  subject String
  sender String
  senderName String
  snippet String
  receivedAt DateTime
  isRead Boolean @default(false)
  handled Boolean @default(false)
  webUrl String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  account EmailAccount @relation(fields:[accountId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  classifications EmailClassification[]
  @@unique([accountId,providerMessageId])
  @@unique([id,userId])
  @@unique([id,userId,workspace])
  @@unique([id,userId,workspace,accountId])
  @@index([userId,receivedAt])
  @@index([userId,workspace,receivedAt(sort: Desc),id(sort: Desc)], map: "emails_inbox_cursor_idx")
  @@index([userId,workspace,accountId,receivedAt(sort: Desc),id(sort: Desc)], map: "emails_account_cursor_idx")
  @@map("emails")
}
model EmailClassification {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String
  emailId String
  tagId String
  tagVersion Int
  contentHash String @default("")
  modelVersion String @default("")
  matched Boolean
  confidence Float
  decision String
  reasoning String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  email Email @relation(fields:[emailId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  tag Tag @relation(fields:[tagId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  @@unique([emailId,tagId])
  @@index([userId,matched,confidence])
  @@index([userId,workspace,tagId,matched,tagVersion,emailId], map: "classifications_workspace_tag_idx")
  @@map("email_classifications")
}
model NotificationPref {
  id String @id @default(cuid())
  userId String @unique
  refreshMinutes Int @default(5)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("notification_prefs")
}

model ProcessingState {
  id String @id
  notBefore DateTime @default(now())
  @@map("processing_state")
}
model ReplyDraft {
  id String @id @default(cuid())
  userId String
  workspace WorkspaceKind
  accountId String
  emailId String
  mode String @default("reply")
  body String @default("")
  revision Int @default(0)
  status String @default("editing")
  rfcMessageId String @unique
  providerDraftId String?
  providerMessageId String?
  leaseId String?
  leaseUntil DateTime?
  lastError String?
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  email Email @relation(fields:[emailId,userId,workspace,accountId],references:[id,userId,workspace,accountId],onDelete:Cascade)
  account EmailAccount @relation(fields:[accountId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  @@unique([emailId,userId,workspace])
  @@unique([emailId,userId,workspace,accountId])
  @@index([userId,workspace,status,updatedAt])
  @@map("reply_drafts")
}

/** Single row (id "app"). Secrets are AES-256-GCM encrypted and never returned by the API. */
model AppSettings {
  id String @id @default("app")
  googleClientId String @default("")
  googleClientSecret String?
  microsoftClientId String @default("")
  microsoftClientSecret String?
  microsoftTenantId String @default("common")
  jevApiKey String?
  updatedAt DateTime @updatedAt
  @@map("app_settings")
}
