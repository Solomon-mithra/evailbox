generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum WorkspaceKind {
  PERSONAL
  WORK
}
enum Priority {
  HIGH
  MEDIUM
  LOW
}
enum Provider {
  GMAIL
  OUTLOOK
}
model User {
  id String @id @db.Uuid
  email String @unique
  displayName String @default("")
  plan String @default("STARTER")
  planSource String @default("preview")
  requestedPlan String?
  planGrantedAt DateTime?
  monthlyUsage MonthlyUsage[]
  replyDrafts ReplyDraft[]
  lastBackgroundSyncAt DateTime?
  workRequested Boolean @default(false)
  workRevision Int @default(0)
  workLeaseId String?
  workLeaseUntil DateTime?
  workNotBefore DateTime @default(now())
  workFailures Int @default(0)
  createdAt DateTime @default(now())
  tags Tag[]
  accounts EmailAccount[]
  emails Email[]
  classifications EmailClassification[]
  notificationPref NotificationPref?
  subscriptions PushSubscription[]
  digestHistory DigestHistory[]
  @@index([workRequested,workNotBefore,lastBackgroundSyncAt])
  @@map("users")
}
model Tag {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String @db.Uuid
  name String
  nameKey String
  description String @default("")
  prompt String
  priority Priority @default(MEDIUM)
  keywords String[] @default([])
  senders String[] @default([])
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  classifications EmailClassification[]
  @@unique([userId,workspace,nameKey])
  @@unique([id,userId])
  @@unique([id,userId,workspace])
  @@map("tags")
}
model EmailAccount {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String @db.Uuid
  provider Provider
  email String
  accessToken String
  refreshToken String?
  expiresAt DateTime
  cursor String?
  rescanStartedAt DateTime?
  lastSync DateTime?
  syncError String?
  syncRequested Boolean @default(true)
  syncRevision Int @default(0)
  syncLeaseUntil DateTime?
  syncLeaseId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  emails Email[]
  mailboxSubscription MailboxSubscription?
  replyDrafts ReplyDraft[]
  @@unique([userId,workspace,provider,email])
  @@unique([id,userId])
  @@unique([id,userId,workspace])
  @@map("email_accounts")
}
model Email {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String @db.Uuid
  accountId String
  lastSeenAt DateTime @default(now())
  contentHash String @default("")
  firstClassifiedAt DateTime?
  inInbox Boolean @default(true)
  replyDraft ReplyDraft?
  providerMessageId String
  subject String
  sender String
  senderName String
  snippet String
  body String?
  receivedAt DateTime
  isRead Boolean @default(false)
  handled Boolean @default(false)
  webUrl String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  account EmailAccount @relation(fields:[accountId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  classifications EmailClassification[]
  @@unique([accountId,providerMessageId])
  @@unique([id,userId])
  @@unique([id,userId,workspace])
  @@unique([id,userId,workspace,accountId])
  @@index([userId,receivedAt])
  @@index([userId,workspace,receivedAt(sort: Desc),id(sort: Desc)], map: "emails_inbox_cursor_idx")
  @@index([userId,workspace,accountId,receivedAt(sort: Desc),id(sort: Desc)], map: "emails_account_cursor_idx")
  @@map("emails")
}
model EmailClassification {
  workspace WorkspaceKind @default(PERSONAL)
  id String @id @default(cuid())
  userId String @db.Uuid
  emailId String
  tagId String
  tagVersion Int
  contentHash String @default("")
  modelVersion String @default("")
  matched Boolean
  confidence Float
  decision String
  reasoning String
  notifiedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  email Email @relation(fields:[emailId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  tag Tag @relation(fields:[tagId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  @@unique([emailId,tagId])
  @@index([userId,matched,confidence])
  @@index([userId,workspace,tagId,matched,tagVersion,emailId], map: "classifications_workspace_tag_idx")
  @@map("email_classifications")
}
model NotificationPref {
  id String @id @default(cuid())
  userId String @unique @db.Uuid
  browserPush Boolean @default(false)
  dailyDigest Boolean @default(false)
  digestTime String @default("09:00")
  timezone String @default("UTC")
  minConfidence Int @default(80)
  refreshMinutes Int @default(5)
  unsubscribeToken String @unique @default(uuid())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("notification_prefs")
}
model PushSubscription {
  id String @id @default(cuid())
  userId String @db.Uuid
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@map("push_subscriptions")
}
model DigestHistory {
  id String @id @default(cuid())
  userId String @db.Uuid
  localDate String
  status String @default("pending")
  leaseUntil DateTime
  sentAt DateTime?
  providerId String?
  windowEnd DateTime @default(now())
  payload Json?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,localDate])
  @@map("digest_history")
}

model MailboxSubscription {
  accountId String @id
  userId String @db.Uuid
  workspace WorkspaceKind
  provider Provider
  providerSubscriptionId String?
  providerMailboxId String?
  resource String?
  clientState String?
  expiresAt DateTime?
  watchHistoryId String?
  status String @default("pending")
  renewalRequested Boolean @default(true)
  renewalRevision Int @default(0)
  renewalLeaseId String?
  renewalLeaseUntil DateTime?
  retryAt DateTime @default(now())
  lastError String?
  updatedAt DateTime @updatedAt
  account EmailAccount @relation(fields:[accountId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  @@unique([accountId,userId,workspace])
  @@index([providerSubscriptionId])
  @@index([renewalRequested,retryAt,expiresAt])
  @@map("mailbox_subscriptions")
}

model MonthlyUsage {
  userId String @db.Uuid
  month DateTime @db.Date
  emails Int @default(0)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,month])
  @@map("monthly_usage")
}
model ProcessingState {
  id String @id
  notBefore DateTime @default(now())
  @@map("processing_state")
}
model ReplyDraft {
  id String @id @default(cuid())
  userId String @db.Uuid
  workspace WorkspaceKind
  accountId String
  emailId String
  mode String @default("reply")
  body String @default("")
  revision Int @default(0)
  status String @default("editing")
  rfcMessageId String @unique
  providerDraftId String?
  providerMessageId String?
  leaseId String?
  leaseUntil DateTime?
  lastError String?
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  email Email @relation(fields:[emailId,userId,workspace,accountId],references:[id,userId,workspace,accountId],onDelete:Cascade)
  account EmailAccount @relation(fields:[accountId,userId,workspace],references:[id,userId,workspace],onDelete:Cascade)
  @@unique([emailId,userId,workspace])
  @@unique([emailId,userId,workspace,accountId])
  @@index([userId,workspace,status,updatedAt])
  @@map("reply_drafts")
}
