# Demo is explicit and never enabled by missing credentials.
APP_MODE=live
NEXT_PUBLIC_APP_URL=https://your-jevinbox-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/jevinbox
DIRECT_URL=postgresql://postgres:password@localhost:5432/jevinbox
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_TENANT_ID=common
JEV_GATEWAY_URL=https://ai-gateway.vercel.sh/v4/ai
JEV_API_KEY=replace-with-vercel-ai-gateway-key
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET_KEY=replace-with-64-hex-characters
CRON_SECRET=replace-with-random-at-least-32-characters
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:admin@example.com
RESEND_API_KEY=replace-with-resend-key
DIGEST_FROM=JevInbox <digest@example.com>
