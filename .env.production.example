# Variable names match .env.local; values belong to this environment.
# Never commit real credentials. Use npm run env:check to detect name drift.

# Application
APP_MODE=live
NEXT_PUBLIC_APP_URL=https://your-evailbox-domain.example

# Supabase and database. Runtime: transaction pooler; migrations: direct/session connection.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-secret-key
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=1

# Google sign-in and Gmail mailbox OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional Outlook OAuth
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# Jev inference
JEV_GATEWAY_URL=https://ai-gateway.vercel.sh/v4/ai
JEV_API_KEY=replace-with-vercel-ai-gateway-key
JEV_MODEL_ID=typesafe-ai/jev
JEV_MODEL_VERSION=1
JEV_CONCURRENCY=4

# Server-only secrets. Keep the encryption key stable for existing encrypted tokens.
ENCRYPTION_SECRET_KEY=replace-with-64-hex-characters
CRON_SECRET=replace-with-random-at-least-32-characters

# Inngest. Environment-specific keys; never copy production keys into tracked templates.
# INNGEST_DEV=1 only when intentionally using the local Inngest dev server.
# INBOX_WORK_CONCURRENCY must fit the Inngest plan (current observed limit: 5).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=0
INBOX_WORK_CONCURRENCY=5

# Optional Gmail push. Configure all four together for authenticated Pub/Sub delivery.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Optional Outlook push: public HTTPS callback URL.
OUTLOOK_WEBHOOK_URL=

# Legacy delivery settings: UNUSED by the current application.
# Retained to preserve existing environment values; these do not enable notifications/digests.
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:admin@example.com
RESEND_API_KEY=replace-with-resend-key
DIGEST_FROM=evailbox <digest@example.com>
