{
  "name": "evailbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H ${HOST:-127.0.0.1}",
    "build": "prisma generate && next build",
    "start": "next start -H ${HOST:-127.0.0.1}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "prepare": "husky",
    "generate:brand-assets": "tsx scripts/generate-brand-assets.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "predev": "prisma migrate deploy",
    "prestart": "prisma migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.88",
    "@hookform/resolvers": "5.9.1",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "ai": "7.0.108",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sanitize-html": "^2.17.7",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "prettier": "3.9.8",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
