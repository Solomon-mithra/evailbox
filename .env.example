# Everything is optional. Copy to .env.local to override defaults.
# OAuth and AI keys are normally entered in Settings instead.

# Address you open evailbox at; OAuth redirect URIs are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Require a password (12+ characters). Set this if anyone else can reach the app.
APP_PASSWORD=

# SQLite location (default: ./data/evailbox.db)
DATABASE_URL=

# 64 hex characters; default is generated into data/secret.key. Keep it stable.
ENCRYPTION_SECRET_KEY=

# demo serves sample mail without calling providers.
APP_MODE=live

# Optional fallbacks for container setups; Settings values win.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
JEV_API_KEY=
